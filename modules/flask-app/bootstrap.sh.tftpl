#!/bin/bash
set -euo pipefail
dnf install -y python3 python3-pip
id flaskapp >/dev/null 2>&1 || useradd --system --home-dir /opt/flaskapp --shell /sbin/nologin flaskapp
install -d -o flaskapp -g flaskapp /opt/flaskapp
echo '${app_base64}' | base64 -d > /opt/flaskapp/app.py
echo '${requirements_base64}' | base64 -d > /opt/flaskapp/requirements.txt
python3 -m venv /opt/flaskapp/venv
/opt/flaskapp/venv/bin/pip install --disable-pip-version-check -r /opt/flaskapp/requirements.txt
chown -R flaskapp:flaskapp /opt/flaskapp
cat >/etc/systemd/system/flaskapp.service <<'UNIT'
[Unit]
Description=Flask learning application
After=network-online.target
Wants=network-online.target
[Service]
User=flaskapp
Group=flaskapp
WorkingDirectory=/opt/flaskapp
Environment=APP_ENV=${environment}
Environment=APP_VERSION=${app_version}
ExecStart=/opt/flaskapp/venv/bin/gunicorn --bind 0.0.0.0:8080 --workers 2 --access-logfile - --error-logfile - app:app
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable --now flaskapp
curl --fail --retry 12 --retry-delay 5 --retry-connrefused http://127.0.0.1:8080/health
